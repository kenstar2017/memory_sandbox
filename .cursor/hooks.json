{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/mark-remembered.py",
        "matcher": "memory_remember|MCP:"
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/ensure-remember.py",
        "loop_limit": 1
      }
    ]
  }
}
