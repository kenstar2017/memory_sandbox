{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BloomBox",
  "version": "0.1.0",
  "identifier": "com.bloombox.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run sync-api && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BloomBox",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [
      "resources/api"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
