#!/usr/bin/env bash
# 记忆沙箱 CLI 快捷入口：./scripts/memory ask "..."
# 支持经 symlink 安装到 PATH（需解析真实路径，否则 ROOT 会变成 /usr/local）
set -euo pipefail

_resolve_root() {
  local src="${BASH_SOURCE[0]:-$0}"
  # 跟随 symlink 到真实脚本（macOS 无 readlink -f）
  while [[ -L "$src" ]]; do
    local link
    link="$(readlink "$src")"
    if [[ "$link" == /* ]]; then
      src="$link"
    else
      src="$(cd "$(dirname "$src")" && pwd)/$link"
    fi
  done
  cd "$(dirname "$src")/.." && pwd
}

_python_ok() {
  local py="$1"
  [[ -x "$py" ]] || return 1
  # 可执行但 dyld 坏掉时仍会 Abort；用短探针检测
  "$py" -c "import sys" >/dev/null 2>&1
}

ROOT="$(_resolve_root)"
PY=""
if _python_ok "${ROOT}/.venv/bin/python"; then
  PY="${ROOT}/.venv/bin/python"
elif _python_ok "$(command -v python3)"; then
  PY="$(command -v python3)"
else
  echo "找不到可用的 python3。可重建虚拟环境：" >&2
  echo "  cd \"${ROOT}\" && /usr/bin/python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi
exec "$PY" "${ROOT}/main.py" "$@"
